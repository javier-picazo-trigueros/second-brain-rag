# node_modules vive casi entero FUERA de OneDrive: pnpm deja en el proyecto solo enlaces (junctions)
# hacia este almacén. Ver README ("Interfaz web"). No uses `npm install`: reemplazaría los enlaces
# por una carpeta real dentro de OneDrive.
virtual-store-dir=C:/venvs/second-brain-web/.pnpm
store-dir=C:/venvs/second-brain-web/store
engine-strict=false
