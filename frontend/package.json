{
  "name": "second-brain-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interfaz web local del segundo cerebro (sin recursos externos)",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
