# Copia este archivo a .env y ajusta. .env no se versiona.
BRAIN_VAULT_PATH=C:\ruta\a\tu\vault
# true = embeddings en CPU (recomendado en consulta, libera ~1,2 GB de VRAM).
# false = GPU, útil en la ingesta masiva con el LLM descargado.
BRAIN_EMBED_ON_CPU=false

# --- Carpeta de datos locales (manifest, caché de BM25, alias) ---
# Por defecto es data/ dentro del repositorio. Si el repositorio está en OneDrive, mejor fuera:
# `brain migrate-data C:\ruta\a\tus\datos` la copia y la verifica, y te dice qué línea poner aquí.
# BRAIN_DATA_DIR=C:\ruta\a\tus\datos

# --- Libros largos y otras notas que no quieres que dominen las búsquedas ---
# Patrones sobre la ruta relativa al vault, con "/" y distinguiendo mayúsculas. "*" casa cualquier
# texto, incluidas las "/". Varios patrones se separan con ";". Van aquí, en tu .env local (no se sube).
# Los ejemplos son genéricos: ajústalos a las carpetas de tu vault.
#
# EXCLUDE: las notas casadas no se indexan; si ya estaban indexadas, el siguiente `brain index`
# las borra del índice (el vault no se toca).
# BRAIN_EXCLUDE_GLOBS=asignatura/libros/*;**/borrador*.md
#
# DEMOTE: siguen indexadas, pero su score se multiplica por BRAIN_DEMOTE_FACTOR (0 < factor <= 1).
# BRAIN_DEMOTE_GLOBS=*/manual-*.md;asignatura/apendices/*
# BRAIN_DEMOTE_FACTOR=0.5

# --- API HTTP y servidor MCP ---
# La API solo escucha en esta máquina. No cambies BRAIN_API_HOST: no tiene autenticación.
# BRAIN_API_PORT=8000
# Origen del front de desarrollo (Vite), separado por ";". En producción no hace falta.
# BRAIN_API_CORS_ORIGINS=http://localhost:5173
# Lo que devuelve el servidor MCP pasa a la conversación del cliente: se mantiene acotado.
# BRAIN_MCP_SNIPPET_CHARS=400
# BRAIN_MCP_MAX_CHARS=20000
